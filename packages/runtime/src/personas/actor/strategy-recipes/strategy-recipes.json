    {
      "name": "break-off",
      "title": "Break off",
      "postures": [
        "defending"
      ],
      "mobility": null,
      "fits": "list",
      "description": "Leaves before it is finished: under a quarter health, or under half stamina with a hostile within two tiles (before a water or wind pin), it steps away from the nearest hostile; under half stamina with no one that close, or under a quarter mana, it stops and recovers, and goes on once a stop no longer recovers.",
      "limits": "Steps away one tile a turn; it does not plan a route out of sight.",
      "requires": [],
      "strategy": {
        "tactics": [
          {
            "when": {
              "vital": "health",
              "below": 25
            },
            "do": {
              "kind": "retreat"
            }
          },
          {
            "when": {
              "vital": "stamina",
              "below": 50,
              "hostileWithin": 2
            },
            "do": {
              "kind": "retreat"
            }
          },
          {
            "when": {
              "vital": "stamina",
              "below": 50
            },
            "do": {
              "kind": "wait"
            }
          },
          {
            "when": {
              "vital": "mana",
              "below": 25
            },
            "do": {
              "kind": "wait"
            }
          }
        ]
      }
    },
