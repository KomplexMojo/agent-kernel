{
  "mcpServers": {
    "agent-kernel-cli": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "cd \"$(git rev-parse --show-toplevel)\" && exec node packages/adapters-cli/src/mcp/server.mjs"
