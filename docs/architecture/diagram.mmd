%% Architecture overview (Ports & Adapters)
flowchart LR
  subgraph Interfaces["Interfaces"]
    UIWeb["ui-web (browser)"]
    PhaserFrame["phaser-frame-view"]
    CardBuilderRenderer["card-builder-phaser-renderer"]
    CardBuilderController["card-builder-controller"]
    GameplaySurface["gameplay surface\ncreateGameplayPhaserRenderer"]
    PhaserIngestion["phaser-surface-ingestion"]
    ScenarioLoader["scenario-loader + preview-view"]
    BridgeClient["sandbox-bridge-client"]
    CLI["CLI (ak.mjs)"]
    MCP["MCP server (ak_* tools)"]
  end

  subgraph Runtime["Runtime (TypeScript)"]
    CommandKernel["shared command kernel"]
    CardAuthoring["card-authoring commands\nnormalize cards + apply properties"]
    RuntimePorts["runtime runner + ports\ncore-owned EffectKind; fail-loud mapping"]
    AdaptiveRunner["adaptive-workflow control plane\nrunAdaptiveWorkflow + injected ports"]
    CoreFacade["core-facade + core-setup\npreview/playback helpers"]
    TickOrch["tick orchestrator"]
    Personas["personas (7 FSMs — enforced boundary:\ncontroller-only imports; JSON view restoration)"]
    OrchestratorPersona["orchestrator persona\nLLM sessions + budget loops"]
    DirectorPersona["director persona\nintent -> PlanArtifact -> BuildSpec"]
    ConfiguratorPersona["configurator persona\nassemble + validate + lock config"]
    AllocatorPersona["allocator persona\nTHE economy: prices, budget-fit\nobjectives, validation, receipts"]
    ModeratorPersona["moderator persona\ntick control: persona order, effect\nfulfilment, affinity resolution, pause gate"]
    AnnotatorPersona["annotator persona\ntelemetry + run summaries"]
    ActorPersona["actor persona\nproposals + all decision objectives\n(including compatibility tuples)"]
    RuntimeFSM["runtime-fsm\nadaptActionToCore"]
    SolverHost["solver-host\nhost dispatch + await"]
    SolverPort["createSolverPort"]
    SolverResolver["resolveActionFromSolverResult"]
    BudgetFitConsumer["Allocator budget-fit model validator"]
  end

  subgraph Core["core-ts"]
    CoreEngine["deterministic state + rules + effects + render buffers"]
    CombatCore["core.applyAttack"]
    AffinityCore["hazard affinity fields + interaction/cancellation matrix"]
    VisibilityCore["visibility radius + supercover LOS\n+ target-dark concealment"]
    MotivationCore["motivation behavior profiles\n(pricing is Allocator policy)"]
    CoreEngine --- AffinityCore
    CoreEngine --- VisibilityCore
    CoreEngine --- MotivationCore
    CoreEngine --- CombatCore
  end

  subgraph Adapters["Adapters (IO boundary)"]
    AWeb["adapters-web"]
    ACli["adapters-cli"]
    ATest["adapters-test"]
    HybridAdapter["hybrid constraint adapter\nActor: opaque tuple stable sort\nAllocator: generic Z3 compiler"]
    AllocatorZ3["Z3 Optimize\nAllocator domain only"]
    TestSolverAdapter["opaque tuple fixture adapter\n(adapters-test)"]
    BridgeServer["sandbox bridge server (WS)\n(adapters-cli)"]
  end

  subgraph External["External Services"]
    IPFS["IPFS gateway"]
    Chain["Blockchain JSON-RPC"]
    LLM["LLM API"]
    Storage["Persistence"]
  end

  UIWeb --> RuntimePorts
  UIWeb --> AWeb
  UIWeb --> PhaserIngestion
  PhaserIngestion --> PhaserFrame
  PhaserFrame --> CardBuilderRenderer
  CardBuilderRenderer --> CardBuilderController
  CardBuilderController --> CardAuthoring
  PhaserFrame --> GameplaySurface
  GameplaySurface --> RuntimePorts
  ScenarioLoader --> CoreFacade
  UIWeb --> ScenarioLoader
  CLI --> ACli
  MCP --> ACli
  ACli -- "ak workflow / ak_workflow_*\nmodel + store + exec ports" --> AdaptiveRunner
  MCP -- "ak_push_to_ui\nGameplayBundle" --> BridgeServer
  BridgeServer -- "WebSocket" --> BridgeClient
  BridgeClient -- "__ak_loadGameplayBundle" --> GameplaySurface
  AWeb --> CommandKernel
  ACli --> CommandKernel
  CommandKernel --> CardAuthoring
  CommandKernel --> RuntimePorts
  CoreFacade --> RuntimePorts
  CoreFacade --> CoreEngine
  RuntimePorts --> TickOrch
  TickOrch --> Personas
  RuntimePorts --> CoreEngine
  Personas --> ActorPersona
  Personas --> OrchestratorPersona
  Personas --> DirectorPersona
  Personas --> ConfiguratorPersona
  Personas --> AllocatorPersona
  Personas --> ModeratorPersona
  Personas --> AnnotatorPersona
  %% Build plane is a persona round (enforced target model)
  CommandKernel -- "build round" --> DirectorPersona
  DirectorPersona -- "BuildSpec" --> ConfiguratorPersona
  ConfiguratorPersona -- "spend proposal" --> AllocatorPersona
  AllocatorPersona -- "BudgetReceiptArtifact" --> AnnotatorPersona
  CardAuthoring -- "price/receipt requests" --> AllocatorPersona
  ModeratorPersona -- "affinity actions + persona order +\nfulfilment plan (CR.5): the runner\nexecutes, it does not decide" --> RuntimeFSM
  ActorPersona -- "attack action" --> RuntimeFSM
  RuntimeFSM -- "apply_attack directive" --> CombatCore
  ActorPersona -- "solver_request effect\n+ Actor-owned tuple" --> RuntimeFSM
  AllocatorPersona -- "solver_request effect\n+ Allocator-owned problem" --> SolverHost
  RuntimeFSM -- "tile geometry + surviving dark\nper-observer scope" --> VisibilityCore
  VisibilityCore -- "scoped actors + hazards" --> ActorPersona
  RuntimeFSM --> SolverPort
  SolverHost --> SolverPort
  SolverPort --> HybridAdapter
  SolverPort -. "test requests" .-> TestSolverAdapter
  HybridAdapter -- "Actor result (no Z3)" --> SolverResolver
  HybridAdapter -- "Allocator expressions only" --> AllocatorZ3
  AllocatorZ3 -- "opaque model" --> SolverHost
  SolverHost -- "host-returned result" --> BudgetFitConsumer
  BudgetFitConsumer -- "validated layout / typed unsat" --> AllocatorPersona
  TestSolverAdapter -- "fixture result" --> SolverResolver
  SolverResolver -- "concrete action" --> RuntimeFSM

  RuntimePorts <--> AWeb
  RuntimePorts <--> ACli
  ATest -.fixtures.-> RuntimePorts
  ATest --> TestSolverAdapter

  AWeb --> IPFS
  AWeb --> Chain
  AWeb --> LLM
  AWeb --> Storage
  ACli --> IPFS
  ACli --> Chain
  ACli --> LLM
  ACli --> Storage
