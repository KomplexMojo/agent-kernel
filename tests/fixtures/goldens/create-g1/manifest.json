{
  "specPath": "spec.json",
  "correlation": {
    "runId": "golden_g1",
    "source": "cli-create"
  },
  "schemas": [
    {
      "schema": "agon/BudgetArtifact",
      "schemaVersion": 1,
      "category": "supporting_input",
      "description": "Token budget input."
    },
    {
      "schema": "agon/BudgetReceiptArtifact",
      "schemaVersion": 1,
      "category": "supporting_input",
      "description": "Canonical budget receipt contract for live build/runtime spend decisions."
    },
    {
      "schema": "agon/BuildSpec",
      "schemaVersion": 1,
      "category": "canonical_build_input",
      "description": "Canonical build intake artifact for authoring and orchestration.",
      "fields": [
        "meta",
        "intent",
        "plan",
        "configurator",
        "authoring",
        "budget",
        "adapters"
      ]
    },
    {
      "schema": "agon/InitialStateArtifact",
      "schemaVersion": 1,
      "category": "canonical_runtime_handoff",
      "description": "Canonical initial actor state for a run.",
      "fields": [
        "meta",
        "simConfigRef",
        "actors"
      ]
    },
    {
      "schema": "agon/PriceList",
      "schemaVersion": 1,
      "category": "supporting_input",
      "description": "Price list for token budgeting."
    },
    {
      "schema": "agon/ResourceBundleArtifact",
      "schemaVersion": 2,
      "category": "canonical_runtime_handoff",
      "description": "Canonical visual resource bundle with embedded data URIs, sprite variants, and Phaser-ready tile effect overlays.",
      "fields": [
        "meta",
        "bundleId",
        "bundleVersion",
        "tileWidth",
        "tileHeight",
        "gatewayBaseUrl",
        "assets",
        "mappings"
      ]
    },
    {
      "schema": "agon/SimConfigArtifact",
      "schemaVersion": 1,
      "category": "canonical_runtime_handoff",
      "description": "Canonical executable simulation configuration.",
      "fields": [
        "meta",
        "planRef",
        "budgetReceiptRef",
        "seed",
        "executionPolicy",
        "layout",
        "constraints"
      ]
    },
    {
      "schema": "agon/SpendProposal",
      "schemaVersion": 1,
      "category": "intermediate",
      "description": "Configurator spend proposal."
    }
  ],
  "artifacts": [
    {
      "id": "budget_golden_g1",
      "schema": "agon/BudgetArtifact",
      "schemaVersion": 1,
      "path": "budget.json"
    },
    {
      "id": "golden_g1_budget_receipt",
      "schema": "agon/BudgetReceiptArtifact",
      "schemaVersion": 1,
      "path": "budget-receipt.json"
    },
    {
      "id": "golden_g1_initial_state",
      "schema": "agon/InitialStateArtifact",
      "schemaVersion": 1,
      "path": "initial-state.json"
    },
    {
      "id": "golden_g1_default_price_list",
      "schema": "agon/PriceList",
      "schemaVersion": 1,
      "path": "price-list.json"
    },
    {
      "id": "golden_g1_resource_bundle",
      "schema": "agon/ResourceBundleArtifact",
      "schemaVersion": 2,
      "path": "resource-bundle.json"
    },
    {
      "id": "golden_g1_sim_config",
      "schema": "agon/SimConfigArtifact",
      "schemaVersion": 1,
      "path": "sim-config.json"
    },
    {
      "id": "golden_g1_spend_proposal",
      "schema": "agon/SpendProposal",
      "schemaVersion": 1,
      "path": "spend-proposal.json"
    }
  ]
}
