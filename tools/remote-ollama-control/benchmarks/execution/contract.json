{
  "schemaVersion": "agent-kernel-execution-metric-contract/v2",
  "evaluatorVersion": "execution-evaluator-v2",
  "qualification": {
    "meanScore": 75,
    "medianScore": 75,
    "minimumSeedScore": 60,
    "probabilisticGateRate": 0.8,
    "deterministicGateRate": 1
  },
  "profiles": {
    "short_v1": { "ticks": 50, "seeds": [0, 1, 2, 3, 4], "checkpoints": [0, 10, 25, 50], "repeats": 1 },
    "standard_v1": { "ticks": 100, "seeds": [0, 1, 2, 3, 4], "checkpoints": [0, 10, 25, 50, 100], "repeats": 1 },
    "stress_v1": { "ticks": 250, "seeds": [0, 1, 2], "checkpoints": [0, 25, 50, 100, 250], "repeats": 1 },
    "soak_v1": { "ticks": 500, "seeds": [0, 1], "checkpoints": [0, 50, 100, 250, 500], "repeats": 1 },
    "replay_v1": { "ticks": 100, "seeds": [0, 1, 2, 3, 4], "checkpoints": [0, 10, 25, 50, 100], "repeats": 2 }
  },
  "invariants": {
    "run_completed": { "description": "Requested horizon completes without crash, timeout, or malformed artifacts." },
    "tick_monotonicity": { "description": "Ticks and phases are monotonic and complete." },
    "actor_legality": { "description": "Actors remain on legal in-bounds tiles." },
    "finite_bounds": { "description": "Declared world-state checkpoints contain finite values and actor vitals remain within bounds at each sampled checkpoint." },
    "effect_integrity": { "description": "Effects and action outcomes reconcile without unexplained loss." },
    "participation": { "description": "Eligible actors receive opportunities within their declared window." },
    "stationary_fidelity": { "description": "Stationary actors never move." },
    "artifact_reconciliation": { "description": "Tick, frame, action, and effect counts reconcile." },
    "unique_actor_ids": { "description": "Actor identities remain unique and stable." },
    "deterministic_replay": { "description": "Normalized same-seed replay artifacts are equivalent." }
  },
  "metrics": {
    "first_action_tick": { "unit": "ticks" },
    "accepted_move_count": { "unit": "count" },
    "max_progress_stall": { "unit": "ticks" },
    "visited_room_count": { "unit": "count" },
    "movement_count": { "unit": "count" },
    "decision_count": { "unit": "count" },
    "max_actor_starvation": { "unit": "ticks" },
    "unique_tile_coverage": { "unit": "ratio" },
    "active_tick_ratio": { "unit": "ratio" },
    "no_stall_margin": { "unit": "ticks" },
    "room_coverage": { "unit": "ratio" },
    "checkpoint_progress": { "unit": "ratio" },
    "patrol_recurrence": { "unit": "count" },
    "stationary_fidelity": { "unit": "ratio" },
    "participation": { "unit": "ratio" },
    "roster_fairness": { "unit": "ratio" },
    "motivation_fidelity": { "unit": "ratio" },
    "contact_latency": { "unit": "ticks" },
    "interaction_damage": { "unit": "count" },
    "survival_plausibility": { "unit": "ratio", "purpose": "diagnostic" },
    "affinity_sensitivity": { "unit": "ratio", "purpose": "diagnostic" },
    "combat_activity": { "unit": "count" },
    "target_interaction": { "unit": "count" },
    "damage_progress": { "unit": "ratio" },
    "endurance_curve": { "unit": "ratio", "purpose": "diagnostic" },
    "damage_regen_interplay": { "unit": "count", "purpose": "diagnostic" },
    "behavioral_diversity": { "unit": "count" },
    "interaction_graph": { "unit": "count" },
    "trigger_correctness": { "unit": "ratio", "purpose": "diagnostic" },
    "impact_evidence": { "unit": "count" },
    "directional_displacement": { "unit": "tiles", "purpose": "diagnostic" },
    "target_correctness": { "unit": "ratio" },
    "reroute_progress": { "unit": "ratio" },
    "rejection_quality": { "unit": "ratio" },
    "pickup_apply_correctness": { "unit": "ratio" },
    "pickup_latency": { "unit": "ticks" },
    "persistent_vital_grant": { "unit": "ratio" },
    "single_consumption": { "unit": "ratio" },
    "recovery_curve": { "unit": "count" },
    "affinity_lifecycle": { "unit": "ratio" },
    "affinity_activity": { "unit": "count" },
    "grant_isolation": { "unit": "ratio" },
    "actor_kind_parity": { "unit": "ratio" },
    "persistent_stacking": { "unit": "ratio" },
    "subsystem_coverage": { "unit": "count" },
    "activity_throughput": { "unit": "actions_per_tick" },
    "artifact_growth": { "unit": "bytes_per_tick" },
    "stability": { "unit": "ratio", "purpose": "diagnostic" },
    "long_run_integrity": { "unit": "ratio", "purpose": "diagnostic" },
    "resource_bounds": { "unit": "ratio", "purpose": "diagnostic" },
    "determinism": { "unit": "ratio" },
    "seed_sensitivity": { "unit": "count", "purpose": "diagnostic" },
    "structural_validity": { "unit": "ratio" },
    "performance": { "unit": "milliseconds_per_tick", "purpose": "diagnostic" },
    "liveness": { "unit": "ratio" },
    "spatial_progress": { "unit": "ratio" }
  }
}
