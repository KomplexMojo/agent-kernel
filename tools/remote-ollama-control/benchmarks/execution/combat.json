    {
      "id": "EX-CB-01",
      "title": "Basic encounter",
      "family": "combat",
      "setup": "Attacking delver and defending warden begin within encounter distance.",
      "profile": "short_v1",
      "invariants": [
        "run_completed",
        "tick_monotonicity",
        "finite_bounds",
        "effect_integrity",
        "participation"
      ],
      "requiredGates": [
        {
          "id": "EX-CB-01-G01",
          "description": "first contact by tick 20",
          "scope": "seed",
          "evidence": "artifact",
          "predicate": {
            "source": "metric",
            "ref": "contact_latency",
            "operator": "max",
            "threshold": 20,
            "unit": "ticks"
          }
        },
        {
          "id": "EX-CB-01-G02",
          "description": "accepted attack or effect evidence",
          "scope": "seed",
          "evidence": "artifact",
          "predicate": {
            "source": "metric",
            "ref": "combat_activity",
            "operator": "min",
            "threshold": 1,
            "unit": "count"
          }
        },
        {
          "id": "EX-CB-01-G03",
          "description": "target receives positive damage",
          "scope": "seed",
          "evidence": "artifact",
          "predicate": {
            "source": "metric",
            "ref": "interaction_damage",
            "operator": "min",
            "threshold": 1,
            "unit": "count"
          }
        }
      ],
      "objectives": {
        "contact_latency": {
          "weight": 30,
          "evidence": "artifact"
        },
        "interaction_damage": {
          "weight": 35,
          "evidence": "artifact"
        },
        "participation": {
          "weight": 20,
          "evidence": "artifact"
        },
        "performance": {
          "weight": 15,
          "evidence": "artifact"
        }
      },
      "thresholds": {
        "contact_latency": {
          "direction": "max",
          "value": 20,
          "unit": "ticks",
          "evidence": "artifact"
        },
        "interaction_damage": {
          "direction": "min",
          "value": 1,
          "unit": "count",
          "evidence": "artifact"
        }
      }
    },
    {
      "id": "EX-CB-02",
      "title": "Affinity advantage sensitivity",
      "family": "combat",
      "setup": "Paired affinity-advantaged and neutral otherwise-identical duels.",
      "profile": "standard_v1",
      "invariants": [
        "run_completed",
        "finite_bounds",
        "effect_integrity",
        "deterministic_replay"
      ],
      "requiredGates": [
        {
          "id": "EX-CB-02-G01",
          "description": "both variants are valid",
          "scope": "aggregate",
          "evidence": "observation",
          "predicate": {
            "source": "metric",
            "ref": "structural_validity",
            "operator": "rate",
            "threshold": 1,
            "unit": "ratio",
            "denominator": "variants",
            "condition": {
              "operator": "exact",
              "threshold": 1
            }
          }
        },
        {
          "id": "EX-CB-02-G02",
          "description": "affinity effects fulfill",
          "scope": "seed",
          "evidence": "artifact",
          "predicate": {
            "source": "invariant",
            "ref": "effect_integrity",
            "operator": "exact",
            "threshold": true
          }
        },
        {
          "id": "EX-CB-02-G03",
          "description": "advantaged metric changes in the declared direction",
          "scope": "paired_variant",
          "evidence": "observation",
          "predicate": {
            "source": "metric",
            "ref": "affinity_sensitivity",
            "operator": "changed_in_direction",
            "threshold": "increase",
            "unit": "ratio",
            "baselineVariant": "neutral",
            "candidateVariant": "advantaged"
          }
        }
      ],
      "objectives": {
        "affinity_sensitivity": {
          "weight": 45,
          "evidence": "observation"
        },
        "combat_activity": {
          "weight": 25,
          "evidence": "artifact"
        },
        "survival_plausibility": {
          "weight": 20,
          "evidence": "observation"
        },
        "performance": {
          "weight": 10,
          "evidence": "artifact"
        }
      },
      "thresholds": {
        "affinity_sensitivity": {
          "direction": "relational",
          "value": "advantaged > neutral",
          "unit": "ratio",
          "evidence": "observation"
        }
      }
    },
