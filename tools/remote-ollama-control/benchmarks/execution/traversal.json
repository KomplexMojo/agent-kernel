          "evidence": "artifact",
          "predicate": {
            "source": "metric",
            "ref": "visited_room_count",
            "operator": "rate",
            "threshold": 0.8,
            "unit": "count",
            "denominator": "seeds",
            "condition": {
              "operator": "min",
              "threshold": 2
            }
          }
        },
        {
          "id": "EX-TR-02-G02",
          "description": "never leave walkable tiles",
          "scope": "seed",
          "evidence": "artifact",
          "predicate": {
            "source": "invariant",
            "ref": "actor_legality",
            "operator": "exact",
            "threshold": true
          }
        }
      ],
      "objectives": {
        "room_coverage": {
          "weight": 45,
          "evidence": "artifact"
        },
        "unique_tile_coverage": {
          "weight": 25,
          "evidence": "artifact"
        },
        "checkpoint_progress": {
          "weight": 20,
          "evidence": "artifact"
        },
        "performance": {
          "weight": 10,
          "evidence": "artifact"
        }
      },
      "thresholds": {
        "room_coverage": {
          "direction": "min",
          "value": 0.67,
          "unit": "ratio",
          "evidence": "artifact"
        }
      }
    },
