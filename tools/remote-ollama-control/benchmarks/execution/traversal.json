{
  "schemaVersion": "agent-kernel-execution-catalog/v1",
  "family": "traversal",
  "scenarios": [
    {
      "id": "EX-TR-01",
      "title": "Single explorer movement",
      "family": "traversal",
      "setup": "One random/exploring delver in one open medium room.",
      "profile": "short_v1",
      "invariants": [
        "run_completed",
        "tick_monotonicity",
        "actor_legality",
        "artifact_reconciliation"
      ],
      "requiredGates": [
        {
          "id": "EX-TR-01-G01",
          "description": "actor acts by tick 10",
          "scope": "seed",
          "evidence": "artifact",
          "predicate": {
            "source": "metric",
            "ref": "first_action_tick",
            "operator": "max",
            "threshold": 10,
            "unit": "ticks"
          }
        },
        {
          "id": "EX-TR-01-G02",
          "description": "at least one legal move per seed",
          "scope": "seed",
          "evidence": "artifact",
          "predicate": {
            "source": "metric",
            "ref": "accepted_move_count",
            "operator": "min",
            "threshold": 1,
            "unit": "count"
          }
        },
        {
          "id": "EX-TR-01-G03",
          "description": "no progress stall longer than 20 ticks",
          "scope": "seed",
          "evidence": "artifact",
          "predicate": {
            "source": "metric",
            "ref": "max_progress_stall",
            "operator": "max",
            "threshold": 20,
            "unit": "ticks"
          }
        }
      ],
      "objectives": {
        "unique_tile_coverage": {
          "weight": 45,
          "evidence": "artifact"
        },
        "active_tick_ratio": {
          "weight": 25,
          "evidence": "artifact"
        },
        "no_stall_margin": {
          "weight": 20,
          "evidence": "artifact"
        },
        "performance": {
          "weight": 10,
          "evidence": "artifact"
        }
      },
      "thresholds": {
        "active_tick_ratio": {
          "direction": "min",
          "value": 0.2,
          "unit": "ratio",
          "evidence": "artifact"
        },
        "no_stall_margin": {
          "direction": "max",
          "value": 20,
          "unit": "ticks",
          "evidence": "artifact"
        }
      }
    },
    {
      "id": "EX-TR-02",
      "title": "Three-room exploration",
      "family": "traversal",
      "setup": "One exploring delver spawns in the first of three connected rooms.",
      "profile": "standard_v1",
      "invariants": [
        "run_completed",
        "tick_monotonicity",
        "actor_legality",
        "artifact_reconciliation"
