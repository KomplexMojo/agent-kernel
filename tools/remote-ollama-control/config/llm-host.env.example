# Copy to config/llm-host.env and fill in your own values.
#
# config/llm-host.env is untracked and MUST stay that way: host addresses,
# ports, and routing details are operator data, not project configuration.
# This template ships placeholders only — no real addresses or ports belong
# in version control.
#
# Placeholders are intentionally invalid so an unedited copy fails loudly
# instead of silently connecting somewhere unintended. The tooling errors with
# a pointer back here when a required value is missing.

LLM_REMOTE_USER=<remote-user>

# Address used on the same local network as the host.
LLM_INTERNAL_HOST=<lan-host-or-ip>

# Address used from outside that network.
#
# Prefer a hostname over a literal IP when the address is dynamic: a residential
# WAN address changes on router reboot or power loss, so a literal IP is correct
# only until the next outage, while a dynamic-DNS name tracks it.
LLM_EXTERNAL_HOST=<wan-hostname-or-ip>

LLM_SSH_PORT=<ssh-port>
LLM_SSH_KEY=~/.ssh/<key-name>
LLM_SSH_CONNECT_TIMEOUT=10

# SSH host alias from ~/.ssh/config. When set, the tooling uses this alias
# instead of constructing SSH args from LLM_*_HOST + LLM_SSH_PORT + LLM_SSH_KEY,
# which keeps connection details in your SSH config rather than here.
LLM_SSH_HOST_ALIAS=<ssh-alias>

# auto   probe and pick a path: prefer internal when it answers, else external.
# internal / external  pin one path and skip probing.
LLM_DEFAULT_ROUTE=auto

# Auto-detection probe deadlines. The internal probe is deliberately short: a
# host on the same network answers in well under 100ms, and every off-network
# run pays this timeout in full before falling through to external.
LLM_ROUTE_PROBE_INTERNAL_MS=600
LLM_ROUTE_PROBE_MS=1500
LLM_REMOTE_PROJECT_DIR=<remote-project-dir>
LLM_REMOTE_SCRIPTS_DIR=<remote-scripts-dir>
LLM_REMOTE_PACKAGE_DIR=<remote-package-dir>
LLM_REMOTE_PROFILE_CMD=<remote-scripts-dir>/remote-ollama-profile

# Safe default is loopback-only, reached over an SSH tunnel. Bind to a routable
# interface only after firewalling the host or when access is otherwise
# controlled.
LLM_OLLAMA_BIND_HOST=127.0.0.1

# Optional local result directory.
LLM_RESULTS_DIR=./results

# Remote manager mode: auto, pid, systemd-user, or systemd-system.
LLM_PROFILE_MANAGER=auto
