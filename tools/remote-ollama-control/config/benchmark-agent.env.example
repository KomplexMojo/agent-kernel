# Copy to ~/.config/agon-benchmark/benchmark-agent.env on the benchmark host.
# Keep the real file untracked. Repository URLs, credentials, and host paths are operator data.

# Required. The source repository to poll. No default: it is operator data.
# AGON_BENCHMARK_SOURCE_REMOTE=
# Required for publication. Left unset, dry-run still works.
# AGON_BENCHMARK_RESULTS_REMOTE=
AGON_BENCHMARK_SOURCE_REPOSITORY=agon
AGON_BENCHMARK_SOURCE_REF=main
AGON_BENCHMARK_RESULT_BRANCH=benchmark-results

# Installation defaults to read-only mode. Pin all three identities before the operator separately
# authorizes GPU execution or result publication.
# Required, all three. Fill from `pnpm run identity -- --env` in the source
# checkout; see benchmarks/execution/RUNBOOK.md. They are pinned rather than
# derived at run time so identity drift fails closed instead of being guessed.
# AGON_BENCHMARK_SCENARIO_HASH=
# AGON_BENCHMARK_MATRIX_HASH=
# AGON_BENCHMARK_EXECUTION_SUITE_HASH=
AGON_BENCHMARK_DRY_RUN=1
AGON_BENCHMARK_LIVE=0

# Required before AGON_BENCHMARK_LIVE=1. Both are repository-relative JSON manifests in the pinned
# source worktree; E5d/operator rollout supplies and reviews their concrete paths.
# AGON_BENCHMARK_RUNTIME_ROUTES=tools/remote-ollama-control/benchmarks/execution/runtime-build-routes.json
# AGON_BENCHMARK_GENERATED_ROUTES=tools/remote-ollama-control/benchmarks/execution/generated-content-routes.json

# Optional overrides; the defaults keep source and result publication isolated.
# AGON_BENCHMARK_SOURCE_MIRROR=%h/.local/share/agon-benchmark/source.git
# AGON_BENCHMARK_STATE_DIR=%h/.local/state/agon-benchmark
# AGON_BENCHMARK_FIXTURE_RESULT=/absolute/path/to/operator-approved-fixture.json

# Liveness beacon. Published every five minutes by agon-heartbeat.timer to its own branch,
# which holds a single force-replaced commit. Kept off AGON_BENCHMARK_RESULT_BRANCH on purpose:
# results are append-only evidence and their publisher rejects a force push.
# AGON_BENCHMARK_HEARTBEAT_BRANCH=benchmark-heartbeat
