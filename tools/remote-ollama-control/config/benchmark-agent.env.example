# Copy to ~/.config/agent-kernel-benchmark/benchmark-agent.env on the benchmark host.
# Keep the real file untracked. Repository URLs, credentials, and host paths are operator data.

AK_BENCHMARK_SOURCE_REMOTE=<source-git-url>
AK_BENCHMARK_RESULTS_REMOTE=<results-git-url>
AK_BENCHMARK_SOURCE_REPOSITORY=agent-kernel
AK_BENCHMARK_SOURCE_REF=main
AK_BENCHMARK_RESULT_BRANCH=benchmark-results

# M4b installs in read-only mode. M5 replaces these pinned identities with the live catalog/matrix
# inputs and explicitly authorizes GPU execution plus result publication.
AK_BENCHMARK_SCENARIO_HASH=<canonical-scenario-sha256>
AK_BENCHMARK_MATRIX_HASH=<canonical-matrix-sha256>
AK_BENCHMARK_DRY_RUN=1

# Optional overrides; the defaults keep source and result publication isolated.
# AK_BENCHMARK_SOURCE_MIRROR=%h/.local/share/agent-kernel-benchmark/source.git
# AK_BENCHMARK_STATE_DIR=%h/.local/state/agent-kernel-benchmark
# AK_BENCHMARK_FIXTURE_RESULT=/absolute/path/to/operator-approved-fixture.json
