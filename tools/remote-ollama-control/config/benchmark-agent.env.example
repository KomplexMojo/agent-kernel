# Copy to ~/.config/agent-kernel-benchmark/benchmark-agent.env on the benchmark host.
# Keep the real file untracked. Repository URLs, credentials, and host paths are operator data.

# Required. The source repository to poll. No default: it is operator data.
# AK_BENCHMARK_SOURCE_REMOTE=
# Required for publication. Left unset, dry-run still works.
# AK_BENCHMARK_RESULTS_REMOTE=
AK_BENCHMARK_SOURCE_REPOSITORY=agent-kernel
AK_BENCHMARK_SOURCE_REF=main
AK_BENCHMARK_RESULT_BRANCH=benchmark-results

# Installation defaults to read-only mode. Pin all three identities before the operator separately
# authorizes GPU execution or result publication.
# Required, all three. Fill from `pnpm run identity -- --env` in the source
# checkout; see benchmarks/execution/RUNBOOK.md. They are pinned rather than
# derived at run time so identity drift fails closed instead of being guessed.
# AK_BENCHMARK_SCENARIO_HASH=
# AK_BENCHMARK_MATRIX_HASH=
# AK_BENCHMARK_EXECUTION_SUITE_HASH=
AK_BENCHMARK_DRY_RUN=1
AK_BENCHMARK_LIVE=0

# Required before AK_BENCHMARK_LIVE=1. Both are repository-relative JSON manifests in the pinned
# source worktree; E5d/operator rollout supplies and reviews their concrete paths.
# AK_BENCHMARK_RUNTIME_ROUTES=tools/remote-ollama-control/benchmarks/execution/runtime-build-routes.json
# AK_BENCHMARK_GENERATED_ROUTES=tools/remote-ollama-control/benchmarks/execution/generated-content-routes.json

# Optional overrides; the defaults keep source and result publication isolated.
# AK_BENCHMARK_SOURCE_MIRROR=%h/.local/share/agent-kernel-benchmark/source.git
# AK_BENCHMARK_STATE_DIR=%h/.local/state/agent-kernel-benchmark
# AK_BENCHMARK_FIXTURE_RESULT=/absolute/path/to/operator-approved-fixture.json

# Liveness beacon. Published every five minutes by agent-kernel-heartbeat.timer to its own branch,
# which holds a single force-replaced commit. Kept off AK_BENCHMARK_RESULT_BRANCH on purpose:
# results are append-only evidence and their publisher rejects a force push.
# AK_BENCHMARK_HEARTBEAT_BRANCH=benchmark-heartbeat
