# Copy to config/ufw.env on the LLM host and fill in your own values.
#
# config/ufw.env is untracked and MUST stay that way: it is firewall policy,
# and publishing it tells a reader exactly which ports are open and which
# sources are trusted. This template ships placeholders only — no real
# addresses, ports, or allowlists belong in version control.
#
# Placeholders are intentionally invalid so an unedited copy fails loudly
# instead of quietly applying the wrong policy.

# SSH access to the LLM host.
#
# ⚠️ UFW_SSH_SOURCES must list EVERY source you need to keep, including any
# off-LAN one (a VPN exit, a jump host). This script begins with
# `ufw --force reset`, so any source you omit is revoked the moment it runs.
# Losing an off-LAN source leaves the LAN working perfectly, so the breakage
# stays invisible until you are away and can no longer connect in to fix it.
# Comma-separated; CIDR or single addresses.
UFW_SSH_PORT=<ssh-port>
UFW_SSH_SOURCES="<lan-cidr>,<remote-source>"

# Ollama profile ports, one per profile (primary / secondary / dual).
#
# Keep this restricted to a trusted LAN, VPN, or admin subnet.
# The script refuses 0.0.0.0/0 here.
UFW_OLLAMA_PORTS="<primary-port>,<secondary-port>,<dual-port>"
UFW_OLLAMA_SOURCES="<lan-cidr>"

# Optional admin services, as port:sources pairs. Leave empty unless needed.
UFW_EXTRA_TCP_RULES=""

# Set to 1 to allow outbound traffic. Most Ubuntu desktops/servers need this.
UFW_ALLOW_OUTGOING=1
