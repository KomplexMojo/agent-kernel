# Operator config: real host addresses, ports, and firewall policy.
# Never commit these — only the *.example templates are tracked.
# The wildcard catches any future config/*.env before it can be added.
config/*.env
!config/*.env.example

results/*
!results/.gitkeep
!results/2026-08-15T18-00-00-000Z-a4-paired-qualification/
!results/2026-08-15T18-00-00-000Z-a4-paired-qualification/result.json
!results/2026-08-15T18-00-00-000Z-a4-paired-qualification/summary.md
*.log
